load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# Sources and test modules are listed explicitly, not globbed: a new module
# must be added here, or it is not built or not run.

py_library(
    name = "tier_drift_lib",
    srcs = [
        "src/tier_drift/__init__.py",
        "src/tier_drift/aggregate.py",
        "src/tier_drift/catalog.py",
        "src/tier_drift/collector.py",
        "src/tier_drift/insights.py",
    ],
    data = ["catalog/models.toml"],
    imports = ["src"],
)

# Every test module is the srcs of one py_test running tests/pytest_main.py,
# which collects exactly the modules in that target's runfiles.
# precompile is disabled because the targets share that main.
TEST_MODULES = [
    "tests/test_collector.py",
    "tests/test_collector_floor.py",
    "tests/test_golden.py",
]

[
    py_test(
        name = module.removeprefix("tests/").removesuffix(".py"),
        srcs = [
            module,
            "tests/pytest_main.py",
        ],
        main = "tests/pytest_main.py",
        precompile = "disabled",
        # The default graph never inherits private snapshot or SSH selectors.
        # Operators can opt in with explicit --test_env flags.
        deps = [
            ":tier_drift_lib",
            "@pypi//pytest",
        ],
    )
    for module in TEST_MODULES
]

# The launcher uses fake SSH/hostname and synthetic aggregates only.
py_test(
    name = "test_tier_drift_collect",
    srcs = ["tests/test_tier_drift_collect.py"],
    main = "tests/test_tier_drift_collect.py",
    data = ["scripts/tier-drift-collect"],
    deps = [":tier_drift_lib"],
    tags = ["no-remote"],
)

py_test(
    name = "test_tier_drift_collect_mutations",
    srcs = ["tests/test_tier_drift_collect_mutations.py"],
    main = "tests/test_tier_drift_collect_mutations.py",
    data = ["scripts/tier-drift-collect", "tests/test_tier_drift_collect.py"],
    deps = [":tier_drift_lib"],
    tags = ["no-remote"],
)
